# Copy to .env and fill in. Never commit .env.
POSTGRES_PASSWORD=change-me-long-random
JWT_SECRET=change-me-long-random-64-chars
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
FRONTEND_URL=https://your-domain.com
WEB_PORT=80
# 1 = only the frontend container's nginx sits in front. Use 2 if the host also has a reverse proxy/load balancer.
TRUST_PROXY=1
